diff -ruN base/src/nsterm.m A/src/nsterm.m
--- base/src/nsterm.m	2026-10-03 17:43:12
+++ A/src/nsterm.m	2026-10-03 17:44:11
@@ -4493,6 +4493,12 @@
 double
 ns_alpha_glyphs_background_alpha (struct frame *f, struct face *face)
 {
+  /* Faces marked `:ns-opaque-background' keep their glyph background
+     fully opaque, so the frame background alpha and the glass blur do
+     not fade them.  */
+  if (face && EQ (face->lface[LFACE_NS_OPAQUE_BACKGROUND_INDEX], Qt))
+    return 1.0;
+
   if (face && face->background == FRAME_BACKGROUND_PIXEL (f))
     return f->alpha_background;
 
